# Full-line comment
export NODE_ENV=production
export	TABBED_EXPORT=enabled

PLAIN=value
QUOTED="double quoted"
SINGLE='single quoted'
# Inline comment after a value
WITH_COMMENT=value # this is a comment
ESCAPED_HASH=value\#kept
MULTILINE="line one
line two"
TRAILING_SPACES=spaced   here

# Duplicate key (dotenv is last-wins)
DUPLICATE=first
DUPLICATE=second

EMPTY=
UNQUOTED_NUMBER=42
UNQUOTED_BOOL=true
