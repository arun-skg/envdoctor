{
  "name": "@arunskg/envdoctor",
  "version": "0.1.2",
  "description": "The ESLint for environment variables — catches missing, unused, duplicate, and leaked config across .env files, source code, Docker Compose, Kubernetes, and GitHub Actions. Local-first: no network, no telemetry.",
  "type": "module",
  "license": "MIT",
  "author": "arun",
  "homepage": "https://github.com/arun-skg/envdoctor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun-skg/envdoctor.git"
  },
  "bugs": {
    "url": "https://github.com/arun-skg/envdoctor/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "envdoctor": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "env",
    "environment",
    "cli",
    "dotenv",
    "audit",
    "lint",
    "ci",
    "envdoctor",
    "environment-variables",
    "kubernetes",
    "docker-compose",
    "github-actions",
    "secrets",
    "devops",
    "ci-cd",
    "nextjs",
    "vite",
    "static-analysis"
  ],
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.2",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
