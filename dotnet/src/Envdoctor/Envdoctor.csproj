<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>Envdoctor</RootNamespace>
    <AssemblyName>envdoctor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>envdoctor</ToolCommandName>
    <PackageId>envdoctor</PackageId>
    <Version>0.1.2</Version>
    <Authors>arun-skg</Authors>
    <Description>Local-first consistency checker for environment variables. Reconciles variables used in source against those defined in .env files, docker-compose, GitHub Actions, and Kubernetes manifests.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/arun-skg/envdoctor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arun-skg/envdoctor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>env;dotenv;environment-variables;secrets;lint;docker-compose;kubernetes;github-actions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

</Project>
